#!/usr/bin/env python3
"""Run one SQS worker. Parallel EC2 workers consume different users' FIFO groups."""
import os
from pathlib import Path
import sys

HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), str(HERE / "lib")]
os.environ.setdefault("HR_EVALS", "on")
from cloudrunner import main

if __name__ == "__main__": main()
