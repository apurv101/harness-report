#!/usr/bin/env python3
"""hr-agentd — the runner.  Leases an evaluation off the queue, runs it, publishes what happened.

This is the half of the site that owns a Docker daemon.  The hosted API records an evaluation and puts a lease
on SQS; this picks it up, runs the ordinary `run.sh`, and republishes the record as it goes so the page that is
polling sees stages, console output and the live call count while they happen.

    ./hr-agentd                     lease and run, forever
    ./hr-agentd --once              lease and run one, then stop
    ./hr-agentd --status            what is on the queue and what the table thinks is running

    HR_QUEUE_URL     the lease queue               (terraform output -raw lease_queue_url)
    HR_TABLE         the run store                 (harness-report)
    AWS_PROFILE      the daemon's own credentials, for SQS and DynamoDB  (operator)
    HR_RUN_PROFILE   the profile the *model* call uses, if it differs    (myasu)
    everything else run.sh already reads from .env — MODEL, HARBOR_TASKS

The two profiles are separate on purpose.  The daemon's credentials reach the queue and the table; the run's
credentials reach Bedrock, and on this laptop those are different accounts.  Without the split the daemon's
AWS_PROFILE is inherited straight into lib/proxy.sh, which forwards it to the proxy container, and every model
call goes out as the control plane.  Unset, run.sh falls back to .env — which is what an EC2 runner wants too,
since there the instance role is both and neither is named.

It runs on the laptop today and on an EC2 runner later, and nothing in it knows the difference: the queue is
the whole coupling.  That is deliberate — the risky part of the run plane is this contract, not the machine,
so the contract gets proven on a machine you can watch.  See RUN-PLANE.md.

What it does NOT do, on purpose: it never modifies the harness under test, it never decides what a run means,
and it holds no web server.  It leases, shells out to run.sh, and writes rows.
"""
import argparse, json, os, signal, subprocess, sys, threading, time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "lib"))
sys.path.insert(0, HERE)

import ddb, leases, store          # noqa: E402
import evals                      # noqa: E402  — the folder layout and the settle rules, shared with serve.py

PUBLISH_EVERY = 2.0      # seconds between republishing a running evaluation
EXTEND_EVERY = 300       # seconds between pushing the lease's visibility window out
EXTEND_BY = 900          # how far out to push it
LEASE_WAIT = 20          # long-poll seconds; an idle runner costs one request per this many


def log(msg):
    print(f"{time.strftime('%H:%M:%S')} hr-agentd: {msg}", flush=True)


def clone_token(installation):
    """A ~1 h token for a private repository, minted here from the app key rather than carried on the queue.

    The laptop reads the .pem from .env; a runner in AWS would read it from Parameter Store the way the API
    does.  Either way the secret never travels with the lease."""
    if not installation: return None
    import auth
    if not auth.can_clone():
        raise RuntimeError("this lease needs a private clone, but GITHUB_APP_ID/GITHUB_APP_KEY are not set here")
    return auth.clone_token(int(installation))[0]


def publish(ev):
    """The record, wherever it is being watched from.  Best effort: a run is not failed by a failed write."""
    try: store.publish_card(ev)
    except (ddb.Error, ValueError) as e: log(f"could not publish {ev['id']}: {e}")


def publish_full(eid):
    """The whole folder — record, every event, the console log — once the run is over."""
    try: store.publish_eval(eid)
    except (ddb.Error, OSError, ValueError) as e: log(f"could not publish {eid} in full: {e}")


def cancelled_remotely(eid):
    try: return bool((store.eval_record(eid) or {}).get("cancelled"))
    except ddb.Error: return False


def run(lease):
    """One evaluation, start to finish.  Returns True when the lease should be deleted."""
    body = lease["body"]
    eid, repo = body.get("eval"), body.get("repo")
    if not eid or not repo:
        log(f"malformed lease {lease['id']}, dropping it")
        return True

    ev = store.eval_record(eid) or evals._record(repo, eid, body.get("user"), "running")
    if ev.get("cancelled") or ev.get("status") not in ("queued", "running"):
        log(f"{eid} was cancelled or already finished before it was leased")
        return True

    try: token = clone_token(body.get("installation"))
    except RuntimeError as e:
        ev.update(status="failed", finished=time.strftime("%Y-%m-%dT%H:%M:%S"), error=str(e))
        publish(ev)
        log(f"{eid}: {e}")
        return True

    os.makedirs(evals._path(eid), exist_ok=True)
    ev.update(status="running", started=ev.get("started") or time.strftime("%Y-%m-%dT%H:%M:%S"))
    # eval.json on this disk is what evals.py's own readers use; the table is what the site reads.
    with open(evals._path(eid, "eval.json"), "w") as f: json.dump(ev, f, indent=2)
    publish(ev)

    env = dict(os.environ, HR_EVENTS=evals._path(eid, "events.jsonl"))
    env.pop("HR_GIT_TOKEN", None)
    if token: env["HR_GIT_TOKEN"] = token
    # The child must not inherit the daemon's control-plane profile: proxy.sh forwards AWS_PROFILE into the
    # proxy container, so inheriting it would bill every model call to the account that owns the queue.
    if os.environ.get("HR_RUN_PROFILE"): env["AWS_PROFILE"] = os.environ["HR_RUN_PROFILE"]
    else: env.pop("AWS_PROFILE", None)      # let run.sh read it from .env

    log(f"{eid}: run.sh {ev['url']} --taskset {body.get('taskset')} --tasks {body.get('task')}")
    with open(evals._path(eid, "console.log"), "wb") as out:
        p = subprocess.Popen(["bash", os.path.join(HERE, "run.sh"), ev["url"],
                              "--taskset", body.get("taskset"), "--tasks", body.get("task"), "--run-id", eid],
                             cwd=HERE, env=env, stdin=subprocess.DEVNULL, stdout=out,
                             stderr=subprocess.STDOUT, start_new_session=True)
    ev["pid"] = p.pid

    stop = threading.Event()

    def keepalive():
        """Two clocks: republish often so the page moves, extend the lease rarely so it never expires under a
        run that is still going.  A lease that expires mid-run is handed to a second runner while the first is
        still working — the same task, twice, both writing the same rows."""
        last_extend = time.time()
        while not stop.wait(PUBLISH_EVERY):
            ev["live"] = evals_live_from_disk(eid, ev)
            ev["events"] = len(evals._read_events(eid))
            publish(ev)
            if time.time() - last_extend > EXTEND_EVERY:
                try: leases.extend(lease["receipt"], EXTEND_BY); last_extend = time.time()
                except leases.Error as e: log(f"could not extend the lease: {e}")
            if cancelled_remotely(eid) and not ev.get("cancelled"):
                log(f"{eid}: cancelled from the site")
                ev["cancelled"] = True
                try: os.killpg(os.getpgid(p.pid), signal.SIGTERM)
                except OSError: pass

    watcher = threading.Thread(target=keepalive, daemon=True)
    watcher.start()
    rc = p.wait()
    stop.set(); watcher.join(timeout=5)

    ev["rc"] = rc
    ev["status"] = "cancelled" if ev.get("cancelled") else ("done" if finished_ok(ev) else "failed")
    ev["finished"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    if ev["status"] == "failed":
        ev["error"] = evals._last_error(eid) or f"run.sh exited with {rc}"
    with open(evals._path(eid, "eval.json"), "w") as f: json.dump(ev, f, indent=2)

    # The run folder first, so a finished evaluation never points at a run the table does not have yet.
    try: store.publish_run(os.path.join(evals.RUNS, ev["run"]), replace=True)
    except (ddb.Error, OSError, ValueError) as e: log(f"could not publish the run: {e}")
    publish_full(eid)
    log(f"{eid}: {ev['status']} (rc={rc})")
    return True


def finished_ok(ev):
    try:
        with open(os.path.join(evals.RUNS, ev["run"], "run.json")) as f:
            return bool(json.load(f).get("finished"))
    except (OSError, ValueError):
        return False


def evals_live_from_disk(eid, ev):
    """evals.live() reads the growing calls.jsonl; here it is called for its numbers, which then travel to the
    site on the record.  MODE is 'on' in this process, so it takes the file-reading path."""
    try: return evals.live(ev)
    except (OSError, ValueError, KeyError) as e:              # a half-written line must never stop a run
        log(f"live counters unavailable: {e}")
        return {}


def status():
    print(f"  queue:  {leases.url() or '(HR_QUEUE_URL unset)'}")
    if leases.configured():
        try: print(f"  depth:  {leases.depth()}")
        except leases.Error as e: print(f"  depth:  unreachable — {e}")
    print(f"  table:  {ddb.target()}")
    try:
        cur = store.running_eval()
        print(f"  active: {cur['id']} ({cur['status']}) on {cur['repo']}" if cur else "  active: nothing")
    except ddb.Error as e:
        print(f"  active: unreadable — {e}")


def main():
    ap = argparse.ArgumentParser(description="lease evaluations off the queue and run them")
    ap.add_argument("--once", action="store_true", help="run one evaluation, then stop")
    ap.add_argument("--status", action="store_true", help="what is queued and what is running")
    a = ap.parse_args()

    if a.status: return status()
    if not leases.configured():
        sys.exit("HR_QUEUE_URL is not set — `terraform -chdir=infra output -raw lease_queue_url`")
    if evals.QUEUED:
        sys.exit("HR_EVALS=queue is the API's setting; this process is the runner and must be able to start runs")

    log(f"leasing from {leases.url()}")
    log(f"publishing to {ddb.target()}")
    while True:
        try:
            lease = leases.receive(wait=LEASE_WAIT, visibility=EXTEND_BY)
        except leases.Error as e:
            log(f"queue unreachable, retrying in 30s: {e}")
            time.sleep(30)
            continue
        if not lease:
            if a.once: log("nothing queued"); return
            continue
        try:
            done = run(lease)
        except Exception as e:                                # one bad lease must not take the runner down;
            log(f"lease failed: {e}")                         # the queue redelivers it, then the DLQ keeps it
            done = False
        if done:
            try: leases.delete(lease["receipt"])
            except leases.Error as e: log(f"could not delete the lease: {e}")
        if a.once: return


if __name__ == "__main__":
    try: main()
    except KeyboardInterrupt: print()
