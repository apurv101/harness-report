# Copy to terraform.tfvars.  Nothing secret belongs here — the client secret, the session secret and
# the app's .pem are SecureStrings in Parameter Store, written by `./bootstrap.sh secrets`.

region  = "us-west-2"
domain  = "harnessreport.com"
project = "harness-report"

github_repo = "apurv101/harness-report"

# The GitHub App's public half (github.com/apps/harness-report).  Leave the client id empty and the
# site serves the runs read-only with sign-in switched off, which is a valid way to run it.
github_client_id = ""
github_app_id    = ""
github_app_slug  = "harness-report"

# The run store.  Must match HR_TABLE in .env, or the laptop and the site read different tables.
table_name = "harness-report"

# The EC2 runner fleet.  See runplane.tf: hr-agentd does not exist yet.
enable_run_plane = false
runner_warm_pool = 0
